# 复制本文件为 `.env`（同目录，或项目根 `.env`）后填写。

# 必填：商汤日日新 API Key（https://token.sensenova.cn/）
SENSENOVA_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 选填：模型
MODEL_NAME=glm-5.2
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 选填：图床（有则走 Pexels，否则回退 picsum.photos 免费占位图）
PEXELS_API_KEY=

# 选填：限速自愈（防 429）
DEMO_CALL_INTERVAL=5
DEMO_RETRIES=5
DEMO_RETRY_WAIT=60
